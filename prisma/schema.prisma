// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ResultRequest {
  id                String    @id @default(uuid())
  requestId         String    @unique // e.g. "NGX-100234"
  fullName          String
  indexNumber       String
  dateOfBirth       String
  examType          String    // WASSCE, NOVDEC, BECE, GBCE, ABCE
  examYear          String    // e.g. "2025"
  email             String
  whatsappNumber    String?
  
  // Payment Details
  paymentReference  String?   @unique
  paymentAmount     Float     @default(30.00)
  currency          String    @default("GHS")
  paymentStatus     String    @default("PENDING") // PENDING, PAID, FAILED, CANCELLED, REFUNDED
  paymentVerifiedAt DateTime?
  
  // Processing Details
  processingStatus  String    @default("AWAITING_PAYMENT") // AWAITING_PAYMENT, PAID, READY_TO_PROCESS, PROCESSING, RESULT_CHECKED, PDF_UPLOADED, EMAIL_SENT, COMPLETED, FAILED
  
  // Voucher Details (Auto-purchased from InConsult or assigned from pool)
  voucherSerial     String?
  voucherPin        String?
  
  // PDF Details
  pdfPath           String?
  pdfFilename       String?
  pdfFileSize       Int?
  pdfUploadedAt     DateTime?
  
  // Email Details
  emailStatus       String    @default("IDLE") // IDLE, QUEUED, SENT, FAILED
  emailSentAt       DateTime?
  emailError        String?
  
  // Metadata
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  auditLogs         AuditLog[]
}

model AuditLog {
  id          String         @id @default(uuid())
  requestId   String?
  request     ResultRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action      String         // PAYMENT_VERIFIED, REQUEST_OPENED, WAEC_PROCESSING_STARTED, RESULT_MARKED_CHECKED, PDF_UPLOADED, EMAIL_SENT, EMAIL_RESENT, REQUEST_COMPLETED, STATUS_UPDATED
  adminEmail  String?
  details     String?
  ipAddress   String?
  createdAt   DateTime       @default(now())
}
