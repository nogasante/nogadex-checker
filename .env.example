# Environment variables for Nogadex Consults WAEC Results Checker

# Database (SQLite for zero-config dev/testing, or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Paystack API Keys (replace with your live or test keys)
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Cloudflare Turnstile Keys (Get free keys at https://dash.cloudflare.com)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Admin Authentication Secret
JWT_SECRET="generate_a_secure_random_string_in_production"
ADMIN_INITIAL_EMAIL="admin@nogadex.com"
ADMIN_INITIAL_PASSWORD="AdminPassword2026!"

# WhatsApp Business Line
NEXT_PUBLIC_WHATSAPP_NUMBER="233534908166"

# Email Provider Configuration (Resend or SMTP)
RESEND_API_KEY=""
EMAIL_FROM="Nogadex Consults <results@results.nogadexconsults.app>"

# Optional SMTP fallback (used if RESEND_API_KEY is not set)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
